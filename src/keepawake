#!/bin/bash
# keepawake - force this Mac fully awake until you press Ctrl+C.
#   * system stays awake (lid open OR closed)
#   * screen stays on and does not lock
#   * works on battery, and keeps working if you unplug while it runs
# On Ctrl+C it hands control back to the automatic ac-keepawake daemon.
# The only root commands it runs are `pmset -a disablesleep 1|0`, which is what
# the installer's sudoers rule allows without a password.
PMSET=/usr/bin/pmset
GREP=/usr/bin/grep
CAFFEINATE=/usr/bin/caffeinate
caff_pid=""
# Put sleep back the way the daemon would have it: on AC stay awake, on battery sleep normally.
# `sudo -n` never prompts: if the sudoers rule is gone (mid-uninstall) it just fails.
restore_power_state() {
  if "$PMSET" -g ps | "$GREP" -q "AC Power"; then sudo -n "$PMSET" -a disablesleep 1; else sudo -n "$PMSET" -a disablesleep 0; fi
}
cleanup() {
  [ -n "$caff_pid" ] && kill "$caff_pid" 2>/dev/null
  restore_power_state
  echo; echo "[keepawake stopped - control returned to the automatic daemon]"; exit 0
}
main() {
  trap cleanup INT TERM HUP
  "$CAFFEINATE" -d -w $$ &
  caff_pid=$!
  if ! sudo "$PMSET" -a disablesleep 1; then
    kill "$caff_pid" 2>/dev/null
    echo "keepawake: 'sudo pmset -a disablesleep 1' failed - is mac-keepawake installed (./install.sh)?" >&2
    exit 1
  fi
  echo "[keepawake ON: screen stays on, awake lid open/closed, survives unplug. Press Ctrl+C to stop.]"
  while :; do sudo -n "$PMSET" -a disablesleep 1; sleep 2; done
}
# Run only when executed (the tests source this file to call its functions).
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main; fi
